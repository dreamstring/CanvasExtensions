<Window x:Class="FigmaGifAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Icon="Assets/app.ico" WindowStyle="None" ResizeMode="CanResize" Title="Canvas extensions" Width="1000" Height="740" MinWidth="840" MinHeight="630" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}" FontFamily="./Assets/#Inter, Segoe UI, Microsoft YaHei UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="8"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Assets/Icons.xaml"/></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="Canvas" Color="#2C2C2C"/><SolidColorBrush x:Key="Surface" Color="#252525"/><SolidColorBrush x:Key="Divider" Color="#444444"/><SolidColorBrush x:Key="Text" Color="#FFFFFF"/><SolidColorBrush x:Key="Control" Color="#383838"/><SolidColorBrush x:Key="Muted" Color="#B3B3B3"/><SolidColorBrush x:Key="Selected" Color="#4A5878"/><SolidColorBrush x:Key="Hover" Color="#444444"/><SolidColorBrush x:Key="Brand" Color="#0C8CE9"/><SolidColorBrush x:Key="Warning" Color="#F5C66F"/><SolidColorBrush x:Key="Success" Color="#85E0A3"/>
   <Style x:Key="FigmaCandidateItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="6,4"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{DynamicResource Control}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Selected}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
     <Grid x:Name="ScrollChrome" Background="Transparent" Width="10" HorizontalAlignment="Right"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb x:Name="Handle" MinHeight="24" Background="{DynamicResource Muted}" Opacity=".5"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton x:Name="After" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track></Grid>
     <ControlTemplate.Triggers><Trigger SourceName="Handle" Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Opacity" Value=".8"/></Trigger><Trigger SourceName="Handle" Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="1"/></Trigger><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="ScrollChrome" Property="Width" Value="Auto"/><Setter TargetName="ScrollChrome" Property="Height" Value="10"/><Setter TargetName="ScrollChrome" Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Handle" Property="MinHeight" Value="0"/><Setter TargetName="Handle" Property="MinWidth" Value="24"/><Setter TargetName="Before" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="After" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
   <Style TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Background" Value="{DynamicResource Control}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="12,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brand}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="CaptionButton" TargetType="Button"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="Close"/></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="#E81123"/><Setter Property="Foreground" Value="White"/></MultiTrigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brand}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="36"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="8,2"/></Style>
   <Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="30" Height="18" BorderThickness="0" BorderBrush="Transparent" Background="{DynamicResource Hover}" CornerRadius="9"><Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Brand}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,12,0,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton Foreground="{DynamicResource Text}" x:Name="Disclosure" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="0,5"><StackPanel Orientation="Horizontal"><Path x:Name="Arrow" Data="M 2,1 L 6,5 L 2,9" Stroke="{DynamicResource Muted}" StrokeThickness="1" Width="10" Height="10" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"/><ContentPresenter Margin="6,0,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brand}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding Header}"/></ToggleButton><ContentPresenter x:Name="Details" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid x:Name="ContentRoot" Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><Viewbox Width="24" Height="24"><Canvas Width="32" Height="32"><Path Data="{StaticResource Icon_component}" Fill="{DynamicResource Text}"/></Canvas></Viewbox><TextBlock Text="Canvas extensions" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,12,0"/><TextBlock x:Name="HostVersion" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" x:Name="ThemeButton" Width="32" Height="28" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" Background="Transparent" Click="ToggleTheme" FocusVisualStyle="{x:Null}" ToolTip="切换到浅色" AutomationProperties.Name="切换到浅色"><Grid Width="18" Height="18"><Viewbox><Canvas Width="24" Height="24"><Path x:Name="SunGlyph" Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L12,4 M12,20 L12,22 M2,12 L4,12 M20,12 L22,12 M4.93,4.93 L6.34,6.34 M17.66,17.66 L19.07,19.07 M4.93,19.07 L6.34,17.66 M17.66,6.34 L19.07,4.93" Stroke="{DynamicResource Text}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path x:Name="MoonGlyph" Visibility="Collapsed" Data="M20.8,13.1 A8.8,8.8 0 1 1 10.9,3.2 A6.8,6.8 0 0 0 20.8,13.1 Z" Stroke="{DynamicResource Text}" StrokeThickness="1.5" StrokeLineJoin="Round"/></Canvas></Viewbox></Grid></Button>
    <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M0,5 L10,5" Width="10" Height="10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/></Button>
    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="ToggleMaximizeWindow" ToolTip="最大化" AutomationProperties.Name="最大化"><Path x:Name="MaximizeGlyph" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Width="10" Height="10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/></Button>
    <Button Tag="Close" Style="{StaticResource CaptionButton}" Click="CloseManagerWindow" ToolTip="关闭助手" AutomationProperties.Name="关闭助手"><Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/></Button>
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="工作区" Foreground="{DynamicResource Muted}" Margin="20,24,0,10" FontSize="11"/><StackPanel><Button x:Name="ExtensionsNav" Style="{StaticResource Nav}" Click="ShowExtensions"><StackPanel Orientation="Horizontal"><Viewbox Width="24"><Canvas Width="32" Height="32"><Path Data="{StaticResource Icon_component}" Fill="{DynamicResource Text}"/></Canvas></Viewbox><TextBlock Text="扩展" VerticalAlignment="Center" Margin="6,0" Width="100"/></StackPanel></Button><Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="ShowSettings"><StackPanel Orientation="Horizontal"><Viewbox Width="24"><Canvas Width="32" Height="32"><Path Data="{StaticResource Icon_settings}" Fill="{DynamicResource Text}"/></Canvas></Viewbox><TextBlock Text="安装与诊断" VerticalAlignment="Center" Margin="6,0" Width="100"/></StackPanel></Button></StackPanel></DockPanel></Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="32,28"><StackPanel x:Name="ExtensionsPage">
    <TextBlock Text="扩展" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="给 Figma 添加顺手的工具。" Foreground="{DynamicResource Muted}" Margin="0,8,0,24"/>
    <Border Background="{DynamicResource Surface}" CornerRadius="6" Padding="16" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Detection" FontWeight="SemiBold"/><TextBlock x:Name="InstallState" Foreground="{DynamicResource Muted}" Margin="0,6,16,0"/></StackPanel><Button Grid.Column="1" Content="注入 / 更新扩展" Click="ShowSettings"/></Grid></Border>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="打开扩展目录" Click="OpenExtensions" ToolTip="将自制扩展文件夹放入此目录，再点击重新扫描"/><TextBlock x:Name="ExtensionCount" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <ItemsControl x:Name="ExtensionList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource Control}" VerticalAlignment="Top"><Viewbox Width="30"><Canvas Width="32" Height="32"><Path Data="{StaticResource Icon_image}" Fill="{DynamicResource Text}"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" Margin="0,0,20,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Info.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Info.Version}" Foreground="{DynamicResource Muted}" Margin="10,0"/></StackPanel><TextBlock Text="{Binding Info.Description}" Foreground="{DynamicResource Muted}" Margin="0,8,0,8"/><TextBlock Text="{Binding PermissionLabel}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource Warning}"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding Enabled,Mode=OneWay}" Click="ExtensionToggled" Tag="{Binding}" ToolTip="选择是否注入；点击应用更改后生效" AutomationProperties.Name="{Binding Info.Name}" VerticalAlignment="Top"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="重新扫描扩展" HorizontalAlignment="Left" Click="Rescan" Margin="0,8,0,16"/>
   </StackPanel>
   <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock Text="安装与诊断" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="检查当前版本，应用扩展选择，或恢复原始资源。" Foreground="{DynamicResource Muted}" Margin="0,8,0,24"/>
    <TextBlock Text="Figma 安装位置" FontWeight="SemiBold"/><ListBox x:Name="FigmaCandidates" ItemContainerStyle="{StaticResource FigmaCandidateItem}" DisplayMemberPath="Label" Margin="0,8,0,8" MaxHeight="90" MinHeight="32" Background="{DynamicResource Control}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Divider}" ScrollViewer.HorizontalScrollBarVisibility="Auto"/><DockPanel Margin="0,0,0,8"><Button Content="使用所选版本" Click="UseFigmaCandidate" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button Content="重新检测" Click="FindFigma" DockPanel.Dock="Right"/><TextBox Background="{DynamicResource Control}" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" BorderBrush="{DynamicResource Divider}" x:Name="FigmaPathInput" ToolTip="可以粘贴 Figma.exe、resources/app.asar 或 app-版本目录的完整路径" Padding="8,6"/></DockPanel><Button Content="使用填写的路径" Click="UseFigmaPath" HorizontalAlignment="Left" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="ExperimentalVersion" IsChecked="True" Checked="CompatibilityChanged" Unchecked="CompatibilityChanged"/><TextBlock Text="实验兼容：允许尝试通过结构检查、但尚未验证的版本" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><Button Content="检查兼容性（只读）" Click="CheckCompatibility" HorizontalAlignment="Left" Margin="0,0,0,18"/>
    <TextBlock Text="安装" FontWeight="SemiBold"/><TextBlock x:Name="GateReason" Margin="0,10,0,14" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal"><Button Content="检查更新计划" Click="CheckPlan"/><Button Content="关闭全部 Figma…" Click="CloseFigma" Margin="8,0,0,0" ToolTip="确认后强制结束所有 Figma 及其后台进程，请先保存文档"/><Button Content="启动 Figma" Click="StartFigma" Margin="8,0,0,0"/><Button x:Name="ApplyButton" Content="应用扩展（注入）" Click="Apply" IsEnabled="False" Margin="8,0,0,0" Background="{DynamicResource Brand}" Foreground="White"/></StackPanel>
    <Expander Header="查看修改计划"><TextBox x:Name="Report" MaxHeight="180" Margin="0,12,0,0" Padding="10" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander>
    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="诊断" FontWeight="SemiBold"/><TextBlock Text="连接异常时读取日志；技术详情默认收起。" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><StackPanel Orientation="Horizontal"><Button Content="读取诊断" Click="ReadDiagnostic"/><Button Content="复制诊断" Click="CopyDiagnostic" Margin="8,0,0,0"/></StackPanel><Expander x:Name="DiagnosticExpander" Header="诊断详情"><TextBox x:Name="DiagnosticReport" MaxHeight="160" IsReadOnly="True" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" BorderThickness="0" Padding="10" Margin="0,10,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander></StackPanel></Border>
    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="恢复" FontWeight="SemiBold"/><TextBlock Text="移除本工具的加载入口，恢复安装前的 Figma 资源。扩展文件和选择会保留。" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><Button Content="恢复原始资源…" Click="Restore" HorizontalAlignment="Left"/></StackPanel></Border>
   </StackPanel></Grid></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Feedback" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Success}"/></Grid></Border>
 </Grid>
</Window>


