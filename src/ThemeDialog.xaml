<Window x:Class="FigmaGifAssistant.ThemeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner" FontSize="12" Foreground="{DynamicResource Text}" FontFamily="./Assets/#Inter, Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#2C2C2C"/><SolidColorBrush x:Key="Text" Color="White"/><SolidColorBrush x:Key="Muted" Color="#B3B3B3"/><SolidColorBrush x:Key="Divider" Color="#444444"/><SolidColorBrush x:Key="Control" Color="#383838"/><SolidColorBrush x:Key="Hover" Color="#444444"/><SolidColorBrush x:Key="Brand" Color="#0C8CE9"/>
  <Style TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="{DynamicResource Control}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brand}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border x:Name="DialogRoot" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10" Padding="24,20,24,24">
  <StackPanel><Grid MouseLeftButtonDown="DragHeader" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Width="28" Height="28" Padding="0" Background="Transparent" Click="Cancel" ToolTip="关闭" AutomationProperties.Name="关闭弹窗"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" Width="10" Height="10"/></Button></Grid>
   <TextBlock x:Name="Message" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource Muted}"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button x:Name="CancelButton" Content="取消" Click="Cancel" IsCancel="True" IsDefault="True" Margin="0,0,8,0"/><Button x:Name="ConfirmButton" Click="Confirm"/></StackPanel>
  </StackPanel>
 </Border>
</Window>
